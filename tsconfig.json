{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "lib",
    "declarationDir": "dist"
  },
  "include": ["lib/**/*.ts"]
}
